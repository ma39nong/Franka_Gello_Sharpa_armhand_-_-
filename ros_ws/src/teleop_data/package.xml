<?xml version="1.0"?>
<package format="3">
  <name>teleop_data</name>
  <version>0.1.0</version>
  <description>Configuration-driven recording, conversion, and replay for teleoperation episodes.</description>
  <maintainer email="descfly@example.com">descfly</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>teleop_core</exec_depend>
  <exec_depend>teleop_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-prompt-toolkit</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
